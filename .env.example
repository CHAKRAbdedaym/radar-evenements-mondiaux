# Copy to .env and fill in. Never commit .env.
COMPOSE_PROJECT_NAME=radar

# Host ports
MONGO_PORT=27017
ME_PORT=8081
API_PORT=8000
APP_PORT=5173

# mongo-express basic auth
ME_USER=admin
ME_PASSWORD=change-me

# MongoDB (no auth: bound to 127.0.0.1 only)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=radar

# Wikimedia requires a descriptive User-Agent with a contact
WIKI_USER_AGENT="RadarEvenements/0.1 (projet etudiant FST Marrakech; contact: EMAIL_HERE)"

# edits-streamer
WIKIS=arwiki,frwiki,enwiki
STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
STREAM_BATCH_SIZE=100
STREAM_FLUSH_SECONDS=2

# diff-worker
DIFF_RATE_PER_SEC=5
DIFF_QUEUE_MAX=2000
DIFF_LOOKBACK_MINUTES=30

# pageviews-loader (rows with fewer views are skipped, except watchlist titles)
PAGEVIEWS_MIN_VIEWS=20
PAGEVIEWS_BULK_SIZE=5000
PAGEVIEWS_PARALLEL=2

# detector
DETECTOR_INTERVAL_SECONDS=60
WINDOW_MINUTES=5
BASELINE_HOURS=24
MIN_HISTORY_HOURS=6
Z_THRESHOLD=3
MIN_USERS=3
ALERT_COOLDOWN_MINUTES=15

# enricher (Wikipedia + Wikidata -> articles.theme; all calls together, <= rate)
ENRICH_BATCH_SIZE=50
ENRICH_RATE_PER_SEC=5
ENRICH_INTERVAL_SECONDS=20
ENRICH_REFRESH_DAYS=7
